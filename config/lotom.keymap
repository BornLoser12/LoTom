#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

// Cygnus layer order: Base, Function, Symbols, Arrow, Mouse, Scroll,
// Utility, Precision, Gesture. Physical positions remain LoTom's 48 keys.
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
    require-prior-idle-ms = <0>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
    require-prior-idle-ms = <0>;
};

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <4>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <60000>;
};

&scroll_runtime_input_processor {
    // Same trackball scroll defaults as Cygnus, active on layer 5 only.
    active-layers = <32>;
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    scale-multiplier = <1>;
    scale-divisor = <60>;
    axis-snap-mode = <AXIS_SNAP_MODE_Y>;
    axis-snap-threshold = <200>;
};

/ {
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        gesture_io {
            slot = <0>;
            display-name = "IO Gesture";
            bindings = <&mo 8>;
            key-positions = <11 12>;
            layers = <0 4>;
            timeout-ms = <50>;
        };

        precision_l_minus {
            slot = <1>;
            display-name = "L minus Precision";
            bindings = <&mo 7>;
            key-positions = <24 25>;
            layers = <0 4>;
            timeout-ms = <50>;
        };
    };

    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        bottom_rotate: behavior_sensor_rotate_bottom {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_BOTTOM";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp LC(PAGE_UP)>;
            ccw-binding = <&kp LC(PAGE_DOWN)>;
            tap-ms = <20>;
        };
    };

    keymap: keymap {
        compatible = "zmk,keymap";

        // Each hand: pinky 1, ring 1, middle 1, index 3 columns.
        // Cygnus's existing inner keys are retained. The five additional
        // LoTom positions (0, 1, 7, 8, 46) are unassigned on every layer.
        default_layer {
            display-name = "Base";
            bindings = <
                &none                  &none
                &kp Q                  &kp W                  &kp E                  &kp R                  &kp T                  &none                  &none                  &kp Y                  &kp U                  &kp I                  &kp O                  &kp P
                &kp A                  &kp S                  &kp D                  &kp F                  &kp G                  &kp LG(LS(S))          &kp LCTL               &kp H                  &kp J                  &kp K                  &lt 4 L                &lt 5 MINUS
                &mt LSHFT Z            &kp X                  &kp C                  &kp V                  &kp B                  &kp ESC                &kp TAB                &kp N                  &kp M                  &kp COMMA              &kp DOT                &mt LSHFT FSLH
                &kp ESC                &kp LGUI               &kp LALT               &kp BSPC               &lt 1 458891           &mt LCTL SPACE         &lt 2 RET              &lt 3 458890           &none                  &kp TAB
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

        FUNCTION {
            display-name = "Function";
            bindings = <
                &none                  &none
                &none                  &kp F10                &kp F7                 &kp F8                 &kp F9                 &none                  &none                  &kp KP_N7              &kp KP_N8              &kp KP_N9              &kp KP_DOT             &kp 458885
                &none                  &kp F11                &kp F4                 &kp F5                 &kp F6                 &trans                 &kp KP_PLUS            &kp KP_N4              &kp KP_N5              &kp KP_N6              &kp KP_MINUS           &kp RCTL
                &kp LSHFT              &kp F12                &kp F1                 &kp F2                 &kp F3                 &kp LC(SPACE)          &kp KP_ASTERISK        &kp KP_N1              &kp KP_N2              &kp KP_N3              &kp KP_SLASH           &kp RSHFT
                &trans                 &trans                 &trans                 &kp DEL                &trans                 &trans                 &kp KP_DOT             &kp KP_N0              &none                  &kp COMMA
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

        NUM {
            display-name = "Symbols";
            bindings = <
                &none                  &none
                &kp LS(N1)             &kp LS(N2)             &kp LS(N3)             &kp LS(N4)             &kp LS(N5)             &none                  &none                  &kp LS(N6)             &kp LS(N7)             &kp LS(N8)             &kp LS(N9)             &kp LS(EQUAL)
                &kp LC(N1)             &kp LC(N2)             &kp LC(N3)             &kp LC(N4)             &kp LS(LC(N5))         &trans                 &trans                 &kp SEMI               &kp SQT                &kp RBKT               &kp NUHS               &kp LBKT
                &mt LSHFT KP_N0        &kp LA(N2)             &kp LA(N3)             &kp LA(N4)             &kp LA(N5)             &trans                 &trans                 &kp 34013321           &kp EQUAL              &kp LS(RBKT)           &kp LS(NUHS)           &mt RSHFT 34013319
                &kp LG(N1)             &kp LG(N2)             &kp LG(N3)             &kp DEL                &trans                 &trans                 &trans                 &trans                 &none                  &kp 458887
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

        ARROW {
            display-name = "Arrow";
            // Hold Arrow + A for Utility. Precision/Gesture use combos.
            bindings = <
                &none                  &none
                &bt BT_SEL 0           &bt BT_SEL 1           &bt BT_SEL 2           &none                  &none                  &none                  &none                  &kp PGUP               &kp HOME               &kp UP                 &kp END                &trans
                &mo 6                  &none                  &none                  &none                  &none                  &studio_unlock         &out OUT_USB           &kp PGDN               &kp LEFT               &kp DOWN               &kp RIGHT              &out OUT_BLE
                &none                  &none                  &none                  &none                  &none                  &bt BT_CLR_ALL         &trans                 &kp LG(TAB)            &kp LG(LC(LEFT))       &kp LA(DOWN)           &kp LG(LC(RIGHT))      &trans
                &trans                 &trans                 &trans                 &kp DEL                &kp LSHFT              &trans                 &trans                 &trans                 &none                  &trans
            >;

            sensor-bindings = <&bottom_rotate &bottom_rotate>;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
                &none                  &none
                &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &none                  &kp LC(W)              &kp LC(PGUP)           &trans                 &kp LC(PGDN)           &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &mkp MCLK              &mkp LCLK              &mkp RCLK              &lt 4 SPACE            &lt 5 SPACE
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &kp BSPC               &mkp MB4               &trans                 &mkp MB5               &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &trans
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
                &none                  &none
                &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &none                  &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
                &none                  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &trans
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

        layer_6 {
            display-name = "Utility";
            bindings = <
                &none                  &none
                &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &none                  &bt BT_SEL 0           &bt BT_SEL 1           &bt BT_SEL 2           &bt BT_SEL 3           &bt BT_SEL 4
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &studio_unlock         &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &kp N1                 &kp N2                 &kp N3                 &kt KP_N4              &trans                 &bootloader            &trans                 &trans                 &trans                 &trans                 &bt BT_CLR
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

        precision_layer {
            display-name = "Precision";
            bindings = <
                &none                  &none
                &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &none                  &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &trans
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

        gesture_layer {
            display-name = "Gesture";
            bindings = <
                &none                  &none
                &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &none                  &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &none                  &trans
            >;

            sensor-bindings = <&bottom_rotate &scroll_up_down>;
        };

    };
};
